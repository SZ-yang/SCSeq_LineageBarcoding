library(clusterProfiler)
library(org.Mm.eg.db)
# 2. Load your data (Change to ce_ig_scores.csv for the baseline)
df <- read.csv("/Users/kevinlin/Library/CloudStorage/Dropbox/Collaboration-and-People/Joshua/git/SCSeq_LineageBarcoding/csv/kevin/Writeup13/joshua_output/lcl_ig_scores.csv")
# 3. Create a named vector and sort it descending
