# BIOST 546: Logistic Regression Demo
# Mirroring the style of Lecture 3 Linear Regression demo
rm(list=ls())
set.seed(10)
# 1) Generating Data ------------------------------------------------------
n <- 200
# 1D covariate X from a uniform distribution
x_train <- sort(runif(n, -5, 5))
# Set true parameters
beta0_true <- 0.5
beta1_true <- 1.5
rm(list=ls())
set.seed(10)
# 1) Generating Data ------------------------------------------------------
n <- 200
# 1D covariate X from a uniform distribution
x_train <- sort(runif(n, -5, 5))
# Set true parameters
beta0_true <- 0.5
beta1_true <- 1.5
# Calculate true log-odds (logit) and convert to probabilities
logit_true <- beta0_true + beta1_true * x_train
prob_true <- exp(logit_true) / (1 + exp(logit_true))
# Sample binary Y from Bernoulli(prob)
y_train <- rbinom(n, size = 1, prob = prob_true)
# Visualize the raw data
plot(x_train, y_train, main = "Logistic Regression: Guessing the Logit",
pch = 16, col = rgb(0,0,0,0.3), xlab = "X (Predictor)", ylab = "Y (Outcome)")
# Let's write a quick function to compute the "Loss" (Negative Log-Likelihood)
calc_nll <- function(y, x, b0, b1) {
logit <- b0 + b1 * x
# log(1 + exp(logit)) is a stable way to compute the log-likelihood
nll <- -sum(y * logit - log(1 + exp(logit)))
return(nll)
}
# BIOST 546: Logistic Regression Demo
rm(list=ls())
set.seed(10)
# 1) Generating Data ------------------------------------------------------
n <- 200
# 1D covariate X from a uniform distribution
x_train <- sort(runif(n, -5, 5))
# Set true parameters
beta0_true <- 0.67
beta1_true <- 1.72
# Calculate true log-odds (logit) and convert to probabilities
logit_true <- beta0_true + beta1_true * x_train
prob_true <- exp(logit_true) / (1 + exp(logit_true))
# Sample binary Y from Bernoulli(prob)
y_train <- rbinom(n, size = 1, prob = prob_true)
# Visualize the raw data
plot(x_train, y_train, main = "Logistic Regression: Guessing the Logit",
pch = 16, col = rgb(0,0,0,0.3), xlab = "X (Predictor)", ylab = "Y (Outcome)")
# 2) "Guessing the Logit" -------------------------------------------------
# We want to see how different coefficients "fit" the data points.
# In Logistic Regression, we minimize the Negative Log-Likelihood (NLL)
# instead of RSS. Smaller NLL = better fit.
# Let's write a quick function to compute the "Loss" (Negative Log-Likelihood)
calc_nll <- function(y, x, b0, b1) {
logit <- b0 + b1 * x
# log(1 + exp(logit)) is a stable way to compute the log-likelihood
nll <- -sum(y * logit - log(1 + exp(logit)))
return(nll)
}
# Guess 1: A flat line (b1 = 0)
b0_g1 <- 0; b1_g1 <- 0
lines(x_train, exp(b0_g1 + b1_g1 * x_train)/(1 + exp(b0_g1 + b1_g1 * x_train)),
col = "coral", lwd = 2)
calc_nll(y_train, x_train, b0_g1, b1_g1)
calc_nll(y_train, x_train, b0_g1, b1_g1)
# Guess 2: The wrong direction (negative slope)
b0_g2 <- 0; b1_g2 <- -1
lines(x_train, exp(b0_g2 + b1_g2 * x_train)/(1 + exp(b0_g2 + b1_g2 * x_train)),
col = "blue", lwd = 2)
calc_nll(y_train, x_train, b0_g2, b1_g2)
# Guess 3: Getting closer
b0_g3 <- 0.3; b1_g3 <- 1
lines(x_train, exp(b0_g3 + b1_g3 * x_train)/(1 + exp(b0_g3 + b1_g3 * x_train)),
col = "forestgreen", lwd = 2)
calc_nll(y_train, x_train, b0_g3, b1_g3)
# 3) Fitting with GLM -----------------------------------------------------
df <- data.frame(y = y_train, x = x_train)
# family = binomial tells R to use the logit link function
lr_res <- glm(y ~ x, data = df, family = binomial)
summary(lr_res)
coef(lr_res)
# 4) Visualizing the "Best Logit" -----------------------------------------
# The automated "best" NLL
calc_nll(y_train, x_train, coef(lr_res)[1], coef(lr_res)[2])
# Plotting the fitted curve
lines(x_train, lr_res$fitted.values, col = "magenta", lwd = 3, lty = 2)
legend("left", legend=c("Guess 1 (Flat)", "Guess 2 (Wrong)", "Guess 3 (Close)", "GLM Fit"),
col=c("coral", "blue", "forestgreen", "magenta"), lty=c(1,1,1,2), lwd=2, cex=0.8)
legend("left", legend=c("Guess 1 (Flat -- everyone is a coinflip)", "Guess 2 (Wrong)", "Guess 3 (Close)", "GLM Fit"),
col=c("coral", "blue", "forestgreen", "magenta"), lty=c(1,1,1,2), lwd=2, cex=0.8)
rm(list=ls())
set.seed(10)
# 1) Generating Data ------------------------------------------------------
n <- 200
# 1D covariate X from a uniform distribution
x_train <- sort(runif(n, -5, 5))
# Set true parameters
beta0_true <- 0.67
beta1_true <- 1.72
# Calculate true log-odds (logit) and convert to probabilities
logit_true <- beta0_true + beta1_true * x_train
prob_true <- exp(logit_true) / (1 + exp(logit_true))
# Sample binary Y from Bernoulli(prob)
y_train <- rbinom(n, size = 1, prob = prob_true)
# Visualize the raw data
plot(x_train, y_train, main = "Logistic Regression: Guessing the Logit",
pch = 16, col = rgb(0,0,0,0.3), xlab = "X (Predictor)", ylab = "Y (Outcome)")
# Let's write a quick function to compute the "Loss" (Negative Log-Likelihood)
calc_nll <- function(y, x, b0, b1) {
logit <- b0 + b1 * x
# log(1 + exp(logit)) is a stable way to compute the log-likelihood
nll <- -sum(y * logit - log(1 + exp(logit)))
return(nll)
}
# Guess 1: A flat line (b1 = 0)
b0_g1 <- 0; b1_g1 <- 0
lines(x_train, exp(b0_g1 + b1_g1 * x_train)/(1 + exp(b0_g1 + b1_g1 * x_train)),
col = "coral", lwd = 2)
calc_nll(y_train, x_train, b0_g1, b1_g1)
# Guess 2: The wrong direction (negative slope)
b0_g2 <- 0; b1_g2 <- -1
lines(x_train, exp(b0_g2 + b1_g2 * x_train)/(1 + exp(b0_g2 + b1_g2 * x_train)),
col = "blue", lwd = 2)
calc_nll(y_train, x_train, b0_g2, b1_g2)
# Guess 3: Getting closer
b0_g3 <- 0.3; b1_g3 <- 1
lines(x_train, exp(b0_g3 + b1_g3 * x_train)/(1 + exp(b0_g3 + b1_g3 * x_train)),
col = "forestgreen", lwd = 2)
calc_nll(y_train, x_train, b0_g3, b1_g3)
# 3) Fitting with GLM -----------------------------------------------------
df <- data.frame(y = y_train, x = x_train)
# family = binomial tells R to use the logit link function
lr_res <- glm(y ~ x, data = df, family = binomial)
summary(lr_res)
coef(lr_res)
# 4) Visualizing the "Best Logit" -----------------------------------------
# The automated "best" NLL
calc_nll(y_train, x_train, coef(lr_res)[1], coef(lr_res)[2])
# This is the "number to beat" (i.e., the loss function) that logistic regression minimizes
# Plotting the fitted curve
lines(x_train, lr_res$fitted.values, col = "magenta", lwd = 3, lty = 2)
legend("left", legend=c("Guess 1 (Flat -- everyone is a coinflip)", "Guess 2 (Wrong)", "Guess 3 (Close)", "GLM Fit"),
col=c("coral", "blue", "forestgreen", "magenta"), lty=c(1,1,1,2), lwd=2, cex=0.8)
