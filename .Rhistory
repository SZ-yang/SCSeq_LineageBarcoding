round(merge_gene_df[c("Mpo", "Ngp", "Ltf", "Camp", "Gata2", "Cebpe", "S100a8", "Itgam"), c(2,3)], 2)
round(merge_gene_df[c("Mpo", "Ngp", "Ltf", "Camp", "Gata2", "Cebpe", "S100a8", "Itgam"), c(2,3)], 3)
