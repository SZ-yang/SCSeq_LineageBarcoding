library(ggplot2)
library(ggrepel)
# Creating the plot
ggplot(merge_gene_df, aes(x = lcl_Score, y = ce_Score, label = Gene)) +
# 1. Add the points first (using a lighter color helps labels stand out)
geom_point(color = "steelblue", alpha = 0.5) +
# 2. Add the labels with repel logic
geom_text_repel(
# Control how many labels are dropped.
# Increase this number to show more genes, decrease it to reduce clutter.
max.overlaps = 15,
# Space around the text box and the point
box.padding = 0.5,
point.padding = 0.3,
# Adjust font size to fit more labels
size = 3,
# min.segment.length = 0 ensures lines are always drawn to the points
min.segment.length = 0,
# Color of the line segments
segment.color = "grey50"
) +
# 3. Clean up the styling
theme_minimal() +
labs(
title = "Gene Expression Comparison",
x = "lcl_Score",
y = "ce_Score"
)
library(ggplot2)
library(ggrepel)
ggplot(merge_gene_df, aes(x = lcl_Score, y = ce_Score, label = Gene)) +
# 1. Add a dotted diagonal reference line (y = x)
# Putting this first keeps it behind the data points
geom_abline(intercept = 0, slope = 1, linetype = "dotted", color = "grey40") +
# 2. Add the data points
geom_point(color = "steelblue", alpha = 0.5) +
# 3. Add the labels with overlap protection
geom_text_repel(
max.overlaps = 15,
box.padding = 0.5,
point.padding = 0.3,
size = 3,
min.segment.length = 0,
segment.color = "grey50"
) +
# 4. Force the 1:1 aspect ratio
coord_fixed(ratio = 1) +
# 5. Styling
theme_minimal() +
labs(
title = "Gene Score Comparison",
subtitle = "Dotted line represents y = x",
x = "lcl_Score",
y = "ce_Score"
)
ggplot(merge_gene_df, aes(x = lcl_Score, y = ce_Score, label = Gene)) +
# 1. Add a dotted diagonal reference line (y = x)
# Putting this first keeps it behind the data points
geom_abline(intercept = 0, slope = 1, linetype = "dotted", color = "grey40") +
# 2. Add the data points
geom_point(color = "steelblue", alpha = 0.5) +
# 3. Add the labels with overlap protection
geom_text_repel(
max.overlaps = 15,
box.padding = 0.1,
point.padding = 0.1,
size = 2,
min.segment.length = 0,
segment.color = "grey50"
) +
# 4. Force the 1:1 aspect ratio
coord_fixed(ratio = 1) +
# 5. Styling
theme_minimal() +
labs(
title = "Gene Score Comparison",
subtitle = "Dotted line represents y = x",
x = "lcl_Score",
y = "ce_Score"
)
ggplot(merge_gene_df, aes(x = lcl_Score, y = ce_Score, label = Gene)) +
# 1. Add a dotted diagonal reference line (y = x)
# Putting this first keeps it behind the data points
geom_abline(intercept = 0, slope = 1, linetype = "dotted", color = "grey40") +
# 2. Add the data points
geom_point(color = "steelblue", alpha = 0.5) +
# 3. Add the labels with overlap protection
geom_text_repel(
# 1. Reduce the padding to 0 or a very small number
point.padding = 0.1,
box.padding = 0.25,
# 2. Increase the attraction to the data point
# Higher force_pull (default is 1) makes labels "snap" closer to the points
force_pull = 5,
# 3. Decrease the repulsion force (default is 1)
# to allow them to sit closer to each other
force = 0.5,
max.overlaps = 20,
size = 3,
min.segment.length = 0,
segment.color = "grey50",
segment.alpha = 0.5
) +
# 4. Force the 1:1 aspect ratio
coord_fixed(ratio = 1) +
# 5. Styling
theme_minimal() +
labs(
title = "Gene Score Comparison",
subtitle = "Dotted line represents y = x",
x = "lcl_Score",
y = "ce_Score"
)
df_merge[c("Mpo", "Ngp", "Ltf", "Camp", "Gata2", "Cebpe", "S100a8", "Itgam"),]
merge_gene_df[c("Mpo", "Ngp", "Ltf", "Camp", "Gata2", "Cebpe", "S100a8", "Itgam"),]
head(merge_gene_df)
rownames(merge_gene_df) <- merge_gene_df$gene
rownames(merge_gene_df) <- merge_gene_df$Gene
